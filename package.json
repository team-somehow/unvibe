  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pwa:icons": "node scripts/pwa-icons.mjs",
    "package:companion": "node scripts/package-companion.mjs",
    "test:signups": "node --test scripts/test-signups.mjs",
    "deploy": "npm run package:companion && npm run build && firebase deploy --only hosting,firestore:rules --project personal-projects-e8a07",
    "companion": "node --env-file-if-exists=.env.local companion/index.mjs",
    "test": "node --test companion/test/*.test.mjs",
    "test:pipeline": "node --env-file-if-exists=.env.local scripts/smoke-pipeline.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
